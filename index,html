<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>我的聊天室</title>
</head>

<body>

<h1>我的聊天室</h1>

<p id="message">等待訊息...</p>

<script>

var number = 0;

function updateMessage()
{
    number++;

    document.getElementById("message").innerHTML =
        "目前更新次數：" + number;
}

updateMessage();

setInterval(updateMessage, 2000);

</script>

</body>
</html>
